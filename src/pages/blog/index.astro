---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Nav from '@/components/Nav.astro'
import Footer from '@/components/Footer.astro'
import PostList from '@/components/PostList.astro'
import { getPublishedPosts } from '@/lib/posts'

const posts = await getPublishedPosts()
---

<BaseLayout
    title="Blog | Abdullah Morrison"
    description="Writing by Abdullah Morrison on software, and whatever else is holding my attention."
>
    <main class="blog">
        <Nav />

        <div class="body">
            <header class="masthead">
                <h2 class="title">Blog</h2>
                <p class="dek">Software, and whatever else is holding my attention.</p>
            </header>

            <PostList posts={posts} />
        </div>
    </main>

    <Footer />
</BaseLayout>

<style lang="scss">
    @use 'variables' as *;

    .blog {
        min-height: 100vh;
        padding: 50px;
    }

    .body {
        max-width: 44em;
        margin: 0 auto;
        padding: 90px 0 120px;
    }

    .masthead {
        margin-bottom: 80px;

        .title {
            line-height: 1;
        }
        .dek {
            margin-top: 16px;
            font-family: var(--font-prose), Georgia, serif;
            font-style: italic;
            font-size: 1.3rem;
            color: $prose-muted;
        }
    }







    @media (max-width: 530px) {
        .blog {
            padding: 30px;
        }
        .body {
            padding: 50px 0 70px;
        }
        .masthead {
            margin-bottom: 50px;
        }
    }
</style>
