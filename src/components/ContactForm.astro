---
// A real static HTML form, which is how Netlify detects it at deploy time.
// Without JS it posts normally and Netlify shows its own success page; with JS
// the submit is intercepted so the reader never leaves the site.
---

<form
    name="contact"
    class="form"
    method="POST"
    data-netlify="true"
    data-netlify-honeypot="bot-field"
>
    <input type="hidden" name="form-name" value="contact" />
    <p class="honeypot">
        <label>
            Leave this empty
            <input type="text" name="bot-field" tabindex="-1" autocomplete="off" />
        </label>
    </p>

    <label class="field">
        <span>Name</span>
        <input type="text" name="name" required autocomplete="name" />
    </label>

    <label class="field">
        <span>Email</span>
        <input type="email" name="email" required autocomplete="email" />
    </label>

    <label class="field">
        <span>Message</span>
        <textarea name="message" rows="6" required></textarea>
    </label>

    <button type="submit" class="submit">Send</button>

    <p class="error" hidden>
        Something went wrong. Email me directly at
        <a href="mailto:abdullahmorrison@gmail.com">abdullahmorrison@gmail.com</a>.
    </p>
</form>

<p class="sent" hidden>Thanks — your message is on its way. I&apos;ll get back to you.</p>

<script>
    const form = document.querySelector<HTMLFormElement>('form.form')
    const sent = document.querySelector<HTMLParagraphElement>('p.sent')
    const error = document.querySelector<HTMLParagraphElement>('p.error')
    const submit = form?.querySelector<HTMLButtonElement>('button.submit')

    form?.addEventListener('submit', async (event) => {
        event.preventDefault()
        if (!submit) return

        error?.setAttribute('hidden', '')
        submit.disabled = true
        submit.textContent = 'Sending…'

        try {
            const body = new URLSearchParams(
                new FormData(form) as unknown as Record<string, string>,
            ).toString()

            const response = await fetch('/', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body,
            })
            if (!response.ok) throw new Error(`Netlify responded ${response.status}`)

            form.setAttribute('hidden', '')
            sent?.removeAttribute('hidden')
        } catch {
            error?.removeAttribute('hidden')
            submit.disabled = false
            submit.textContent = 'Send'
        }
    })
</script>

<style lang="scss">
    @use 'variables' as *;

    // Local to this component. Promote it to variables.scss if anything else
    // ever needs a non-text white.
    $highlight: #ffffff;

    .form {
        display: flex;
        flex-direction: column;
        gap: 25px;
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 8px;

        span {
            color: $text-secondary;
            font-size: $heading5;
        }

        input,
        textarea {
            font: inherit;
            color: $text-primary;
            background: transparent;
            border: none;
            border-bottom: 1px solid $title-accent;
            padding: 8px 0;
            resize: vertical;
            transition: border-color 0.25s ease;

            &:focus {
                outline: none;
                border-bottom-color: $highlight;
            }
        }
    }

    .submit {
        align-self: flex-start;
        font: inherit;
        font-size: $heading5;
        color: $text-primary;
        background: transparent;
        border: 1px solid $title-accent;
        padding: 10px 30px;
        cursor: pointer;
        transition: background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease;

        &:hover:not(:disabled) {
            border-color: $highlight;
            background: $highlight;
            color: $pseudo-black;
        }
        &:disabled {
            color: $text-secondary;
            cursor: default;
        }
    }

    .sent {
        font-size: $heading5;
    }

    .error {
        color: $sharp-accent;

        a {
            text-decoration: underline;
        }
    }

    // Bots fill this in; people never see it.
    .honeypot {
        display: none;
    }
</style>
