---
const links = [
    { href: 'https://linkedin.com/in/abdullah-morrison', label: 'LinkedIn' },
    { href: 'https://github.com/abdullahmorrison', label: 'GitHub' },
    { href: 'https://abdullahmorrison.github.io/resume/', label: 'My Resume' },
]
---

<footer class="footer">
    <h4 class="logo">My Portfolio</h4>
    <ul>
        {
            links.map((link) => (
                <li>
                    <a href={link.href} target="_blank" rel="noopener noreferrer">
                        {link.label}
                    </a>
                </li>
            ))
        }
    </ul>
    <p>This website was made with Astro.</p>
</footer>

<style lang="scss">
    @use 'variables' as *;

    .footer {
        color: black;
        background-color: white;
        padding: 100px;

        .logo {
            margin-bottom: 50px;
            &::after {
                content: '';
                display: inline-block;
                width: 8px;
                height: 8px;
                background-color: red;
                border-radius: 50%;
                margin-left: 5px;
            }
        }
        ul {
            display: flex;
            gap: 20px;
            margin-bottom: 20px;

            li {
                list-style-type: none;
                margin-bottom: 10px;

                a {
                    text-decoration: underline;
                    color: $title-accent;
                }
            }
        }
        p {
            color: $text-secondary;
        }
    }

    @media (max-width: 530px) {
        .footer {
            padding: 50px 30px;
        }
    }
</style>
